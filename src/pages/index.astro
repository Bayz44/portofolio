---

<!DOCTYPE html>
  <html lang="id">
    <head>
      <meta charset="UTF-8" />
      <meta name="viewport" content="width=device-width, initial-scale=1.0" />
      <title>Bayu Andika — Profil Kerja</title>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;700;800;900&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
        <style>
  :root{
    --bg:#0B0B0C; --ink:#F3F2EE; --ink-soft:#8C8A83;
    --card:#141414; --line:#242422; --accent:#D8FF3E;
  }
  *{margin:0;padding:0;box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{ background:var(--bg); color:var(--ink); font-family:'Inter',sans-serif; overflow-x:hidden; }
  @media (prefers-reduced-motion: reduce){ html{scroll-behavior:auto;} *{animation:none !important; transition:none !important;} }
  a{color:inherit; text-decoration:none;}
  .wrap{max-width:1180px; margin:0 auto; padding:0 26px;}
  .disp{font-family:'Archivo',sans-serif;}
  .k{ font-size:11.5px; letter-spacing:.14em; text-transform:uppercase; font-weight:700; color:var(--ink-soft); }

  /* marquee */
  .marquee{ border-top:1px solid var(--line); border-bottom:1px solid var(--line); padding:12px 0; overflow:hidden; white-space:nowrap; }
  .marquee-track{ display:inline-flex; animation:scroll 24s linear infinite; }
  .marquee span{ font-family:'Archivo',sans-serif; font-weight:700; font-size:13px; letter-spacing:.03em; padding:0 22px; text-transform:uppercase; color:var(--ink-soft); }
  .marquee span.hi{ color:var(--accent); }
  @keyframes scroll{ from{transform:translateX(0);} to{transform:translateX(-50%);} }

  header{ position:sticky; top:0; z-index:50; background:rgba(11,11,12,.85); backdrop-filter:blur(12px); }
  .navrow{ display:flex; align-items:center; justify-content:space-between; height:76px; }
  .brand{ font-family:'Archivo',sans-serif; font-weight:900; font-size:18px; }
  .brand span{ color:var(--accent); }
  nav ul{ list-style:none; display:flex; gap:28px; }
  nav a{ font-size:13px; font-weight:600; color:var(--ink-soft); }
  nav a:hover{ color:var(--ink); }
  .clock{
    display:flex; align-items:center; gap:8px; font-family:'Archivo',sans-serif; font-size:12.5px; font-weight:700; color:var(--ink-soft);
  }
  .clock .pulse{ width:7px; height:7px; border-radius:50%; background:var(--accent); animation:pulse 1.6s ease-in-out infinite; }
  @keyframes pulse{ 0%,100%{ opacity:1; } 50%{ opacity:.3; } }
  .cta-nav{ background:var(--accent); color:#0B0B0C; padding:10px 20px; border-radius:999px; font-size:12.5px; font-weight:800; text-transform:uppercase; }
  .cta-nav:hover{ opacity:.85; }

  /* hero */
  .hero{ padding:64px 0 30px; }
  .hero-eyebrow{ display:flex; align-items:center; gap:10px; margin-bottom:22px; }
  .hero-eyebrow .dot{ width:6px;height:6px;border-radius:50%; background:var(--accent); }
  .stack{
    font-family:'Archivo',sans-serif; font-weight:900; text-transform:uppercase;
    font-size:clamp(38px,8.6vw,108px); line-height:.92; letter-spacing:-.02em;
  }
  .stack .row{ display:flex; gap:.28em; flex-wrap:wrap; }
  .stack .row .thin{ font-weight:500; color:var(--ink-soft); font-style:normal; }
  .stack .row .accent{ color:var(--accent); }
  .hero-sub{ margin-top:26px; color:var(--ink-soft); font-size:16px; max-width:520px; line-height:1.6; }
  .hero-ctas{ display:flex; gap:12px; margin-top:34px; flex-wrap:wrap; }
  .btn-lime{ background:var(--accent); color:#0B0B0C; font-weight:800; font-size:13px; text-transform:uppercase; padding:14px 26px; border-radius:999px; }
  .btn-lime:hover{ opacity:.85; }
  .btn-out{ border:1px solid var(--line); color:var(--ink); font-weight:700; font-size:13px; text-transform:uppercase; padding:14px 26px; border-radius:999px; }
  .btn-out:hover{ border-color:var(--ink-soft); }

  .stat-strip{
    display:grid; grid-template-columns:repeat(3,1fr); gap:1px; background:var(--line);
    margin-top:56px; border:1px solid var(--line);
  }
  .stat-strip div{ background:var(--bg); padding:24px 22px; }
  .stat-num{ font-family:'Archivo',sans-serif; font-weight:900; font-size:34px; color:var(--accent); }
  .stat-lbl{ font-size:12px; color:var(--ink-soft); margin-top:6px; }

  section{ padding:80px 0; border-top:1px solid var(--line); }
  .sec-head{ display:flex; align-items:baseline; justify-content:space-between; margin-bottom:40px; flex-wrap:wrap; gap:14px; }
  .sec-head h2{ font-family:'Archivo',sans-serif; font-weight:800; font-size:clamp(24px,4vw,36px); text-transform:uppercase; letter-spacing:-.01em; }

  /* work list */
  .wrow{
    display:grid; grid-template-columns:60px 1fr auto; gap:20px; align-items:center;
    padding:26px 6px; border-bottom:1px solid var(--line);
    transition:background .2s ease;
  }
  .wrow:hover{ background:var(--card); }
  .wrow:first-child{ border-top:1px solid var(--line); }
  .wnum{ font-family:'Archivo',sans-serif; font-weight:800; color:var(--ink-soft); font-size:14px; }
  .wtitle{ font-family:'Archivo',sans-serif; font-weight:800; font-size:clamp(17px,2.4vw,24px); text-transform:uppercase; }
  .wtitle .accent{ color:var(--accent); }
  .wtags{ font-size:12px; color:var(--ink-soft); margin-top:6px; }
  .wdate{ font-size:12.5px; color:var(--ink-soft); white-space:nowrap; text-align:right; font-weight:600; }

  /* skill cards */
  .skill-grid{ display:grid; grid-template-columns:repeat(4,1fr); gap:14px; }
  .skill-card{ background:var(--card); border:1px solid var(--line); border-radius:10px; padding:24px; transition:border-color .2s ease, transform .2s ease; }
  .skill-card:hover{ border-color:var(--accent); transform:translateY(-3px); }
  .skill-num{ font-family:'Archivo',sans-serif; font-weight:900; font-size:13px; color:var(--accent); margin-bottom:22px; }
  .skill-card h3{ font-family:'Archivo',sans-serif; font-weight:800; font-size:15px; text-transform:uppercase; margin-bottom:8px; }
  .skill-card p{ font-size:12.5px; color:var(--ink-soft); line-height:1.5; }

  /* project spotlight */
  .spot{ background:var(--card); border:1px solid var(--line); border-radius:14px; padding:44px 38px; position:relative; overflow:hidden; }
  .spot-kicker{ display:flex; align-items:center; gap:10px; margin-bottom:18px; }
  .spot h3{ font-family:'Archivo',sans-serif; font-weight:900; text-transform:uppercase; font-size:clamp(28px,5.6vw,50px); letter-spacing:-.02em; }
  .spot h3 span{ color:var(--accent); }
  .spot p{ margin-top:16px; color:var(--ink-soft); font-size:14.5px; max-width:62ch; }
  .spot p + p{ margin-top:10px; }
  .spot-tags{ display:flex; flex-wrap:wrap; gap:8px; margin-top:24px; }
  .spot-tags span{ font-size:11.5px; font-weight:600; padding:7px 13px; border:1px solid var(--line); border-radius:999px; color:var(--ink-soft); }
  .spot-ctas{ display:flex; gap:12px; margin-top:30px; flex-wrap:wrap; }

  /* education */
  .edu{ display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:14px; padding:24px 0; }
  .edu b{ font-family:'Archivo',sans-serif; font-weight:800; font-size:18px; text-transform:uppercase; }
  .edu .sub{ color:var(--ink-soft); font-size:13px; margin-top:4px; }

  /* contact */
  .contact-stack{ font-family:'Archivo',sans-serif; font-weight:900; text-transform:uppercase; font-size:clamp(34px,7.2vw,84px); line-height:.94; letter-spacing:-.02em; }
  .contact-stack span{ color:var(--accent); }
  .coord{ display:flex; flex-wrap:wrap; gap:34px; margin-top:44px; }
  .coord p{ font-family:'Archivo',sans-serif; font-weight:700; font-size:14px; margin-top:6px; }

  footer{ padding:32px 0; border-top:1px solid var(--line); }
  .foot-row{ display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:14px; }
  .foot-links{ display:flex; gap:20px; }
  .foot-links a{ font-size:12px; font-weight:700; text-transform:uppercase; color:var(--ink-soft); }
  .foot-links a:hover{ color:var(--ink); }

  .reveal{ opacity:0; transform:translateY(16px); transition:opacity .55s ease, transform .55s ease; }
  .reveal.in{ opacity:1; transform:translateY(0); }

  @media (max-width:820px){
    nav ul{ display:none; }
    .stat-strip{ grid-template-columns:1fr; }
    .skill-grid{ grid-template-columns:1fr 1fr; }
    .wrow{ grid-template-columns:32px 1fr; }
    .wdate{ grid-column:2; text-align:left; }
  }
  @media (max-width:520px){ .skill-grid{ grid-template-columns:1fr; } }
  :focus-visible{ outline:2px solid var(--accent); outline-offset:3px; }
</style>
        </head>
